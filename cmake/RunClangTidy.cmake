if(NOT DEFINED SOURCE_LIST OR NOT EXISTS "${SOURCE_LIST}")
    message(FATAL_ERROR "SOURCE_LIST must name an existing file")
endif()
if(NOT DEFINED CLANG_TIDY OR NOT EXISTS "${CLANG_TIDY}")
    message(FATAL_ERROR "CLANG_TIDY must name the clang-tidy executable")
endif()
file(STRINGS "${SOURCE_LIST}" _sources ENCODING UTF-8)
set(_args -p "${BUILD_DIR}" --allow-no-checks)
if(FIX)
    list(APPEND _args --fix)
endif()
foreach(_source IN LISTS _sources)
    execute_process(COMMAND "${CLANG_TIDY}" ${_args} "${_source}" RESULT_VARIABLE _result)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "clang-tidy failed for ${_source}: ${_result}")
    endif()
endforeach()
