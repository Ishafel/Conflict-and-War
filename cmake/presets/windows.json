{
  "version": 6,
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "win-clang-debug",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-clang-relwithdebinfo",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "win-clang-release",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-x64-clang-dbg",
      "displayName": "Win x64 Clang Debug",
      "inherits": "win-clang-debug",
      "binaryDir": "${sourceDir}/build/win-x64-clang-dbg",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-clang",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/win-x64-clang.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win-x64-clang-rwdi",
      "displayName": "Win x64 Clang RelWithDebInfo",
      "inherits": "win-clang-relwithdebinfo",
      "binaryDir": "${sourceDir}/build/win-x64-clang-rwdi",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-clang",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/win-x64-clang.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win-x64-clang-rel",
      "displayName": "Win x64 Clang Release",
      "inherits": "win-clang-release",
      "binaryDir": "${sourceDir}/build/win-x64-clang-rel",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-clang",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/win-x64-clang.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-x64-clang-dbg",
      "configurePreset": "win-x64-clang-dbg"
    },
    {
      "name": "win-x64-clang-rwdi",
      "configurePreset": "win-x64-clang-rwdi"
    },
    {
      "name": "win-x64-clang-rel",
      "configurePreset": "win-x64-clang-rel"
    }
  ],
  "testPresets": [
    {
      "name": "win-x64-clang-dbg",
      "configurePreset": "win-x64-clang-dbg",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^PoseidonFoundationTests - "
        }
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120
      }
    },
    {
      "name": "win-x64-clang-rwdi",
      "configurePreset": "win-x64-clang-rwdi",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^PoseidonFoundationTests - "
        }
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120
      }
    },
    {
      "name": "win-x64-clang-rel",
      "configurePreset": "win-x64-clang-rel",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^PoseidonFoundationTests - "
        }
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120
      }
    }
  ]
}
