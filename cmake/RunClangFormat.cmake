# Portable to BSD/macOS; each source path is passed as a separate argument.
if(NOT DEFINED SOURCE_LIST OR NOT EXISTS "${SOURCE_LIST}")
    message(FATAL_ERROR "SOURCE_LIST must name an existing file")
endif()
if(NOT DEFINED CLANG_FORMAT OR NOT EXISTS "${CLANG_FORMAT}")
    message(FATAL_ERROR "CLANG_FORMAT must name the clang-format executable")
endif()
file(STRINGS "${SOURCE_LIST}" _sources ENCODING UTF-8)
if(FIX)
    set(_args -i)
else()
    set(_args --dry-run --Werror)
endif()
foreach(_source IN LISTS _sources)
    execute_process(COMMAND "${CLANG_FORMAT}" ${_args} "${_source}" RESULT_VARIABLE _result)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "clang-format failed for ${_source}: ${_result}")
    endif()
endforeach()
